{
  "schema_version": 1,
  "id": "task-drawer-cycle",
  "title": "Chat titlebar task drawer open/close cycle and column paging",
  "phases": [
    {
      "id": "chat-prime",
      "label": "Mount the seeded chat, where the drawer is hostable",
      "settle_ms": 250,
      "observe_ms": 1000,
      "action": { "kind": "navigate", "path": "/chat/w/{{workspaceId}}/c/{{chatChannelId}}" }
    },
    {
      "id": "drawer-open-cold",
      "label": "Open the task drawer with no board cache",
      "settle_ms": 250,
      "observe_ms": 1500,
      "action": { "kind": "click", "selector": "button[aria-label=\"Tasks\"]" }
    },
    {
      "id": "drawer-column-page",
      "label": "Scroll the Todo column to its window end, which asks for page 2",
      "settle_ms": 150,
      "observe_ms": 1500,
      "action": {
        "kind": "scroll",
        "selector": "[data-tasks-column][data-status=\"todo\"] [data-tasks-column-body]",
        "delta_y": 4000
      }
    },
    {
      "id": "drawer-close",
      "label": "Close the drawer — the render window pins back to page 1",
      "settle_ms": 250,
      "observe_ms": 1000,
      "action": { "kind": "click", "selector": "button[aria-label=\"Close tasks\"]" }
    },
    {
      "id": "chat-remount-with-closed-drawer",
      "label": "Re-mount Chat while the closed drawer's shell stays in the tree",
      "settle_ms": 250,
      "observe_ms": 1000,
      "action": { "kind": "navigate", "path": "/tasks" }
    },
    {
      "id": "chat-remount-return",
      "label": "Return to the seeded chat — the mount the closed drawer taxes",
      "settle_ms": 250,
      "observe_ms": 1000,
      "action": { "kind": "navigate", "path": "/chat/w/{{workspaceId}}/c/{{chatChannelId}}" }
    },
    {
      "id": "drawer-open-warm",
      "label": "Re-open the drawer over a warm board cache",
      "settle_ms": 250,
      "observe_ms": 1200,
      "action": { "kind": "click", "selector": "button[aria-label=\"Tasks\"]" }
    }
  ]
}
