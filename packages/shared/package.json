{
  "name": "@silverhand/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api/index.ts",
    "./db": "./src/db/index.ts",
    "./db/baseline-schema": "./src/db/baseline-schema.ts",
    "./db/migrations": "./src/db/migrations.ts",
    "./db/schema-epochs": "./src/db/schema-epochs.ts",
    "./db/schema": "./src/db/schema.ts",
    "./cli-command-manifest": "./src/cli-command-manifest.ts",
    "./reference-markdown": "./src/reference-markdown.ts",
    "./driver": "./src/driver/index.ts",
    "./app-data-layout": "./src/app-data-layout.ts"
  },
  "scripts": {
    "generate:backend-admission": "node scripts/generate-backend-admission.mjs",
    "check:backend-admission": "node scripts/generate-backend-admission.mjs --check",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "mdast-util-from-markdown": "^2.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.7.5",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
