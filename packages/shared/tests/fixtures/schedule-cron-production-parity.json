    {
      "name": "last_day_supported_by_both",
      "expression": "0 9 L * *",
      "timezone": "UTC",
      "after": 1767225600000,
      "expected": { "kind": "next", "instant": 1769850000000 }
    },
    {
      "name": "dst_gap_moves_to_same_relative_minute",
      "expression": "30 2 * * *",
