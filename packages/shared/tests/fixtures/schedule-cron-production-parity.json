      "expression": "0 9 * * MON#2/2",
      "timezone": "UTC",
      "after": 1767225600000,
      "expected": { "kind": "error", "code": "invalid_cron_expression" }
    },
    {
      "name": "nth_dow_range_is_refused",
      "expression": "0 9 * * MON#2-FRI",
