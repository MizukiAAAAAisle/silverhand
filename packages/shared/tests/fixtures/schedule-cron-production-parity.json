      "after": 1767225600000,
      "expected": { "kind": "next", "instant": 1767258000000 }
    },
    {
      "name": "question_mark_dom_step",
      "expression": "0 9 ?/2 * *",
      "timezone": "UTC",
      "after": 1767225600000,
      "expected": { "kind": "next", "instant": 1767258000000 }
    },
    {
