{
  "authority": {
    "signer": "packages/backend ScheduleService.create",
    "engine": "cron-parser@4.9.0",
    "consumer": "rust backend-sqlite ProductionCronEvaluator"
  },
  "cases": [
    {
      "name": "single_value_step_first",
      "expression": "1/5 * * * *",
      "timezone": "UTC",
      "after": 1767225600000,
      "expected": { "kind": "next", "instant": 1767225660000 }
    },
    {
      "name": "single_value_step_continues",
      "expression": "1/5 * * * *",
      "timezone": "UTC",
      "after": 1767225660000,
      "expected": { "kind": "next", "instant": 1767225960000 }
    },
    {
      "name": "range_step",
      "expression": "1-11/5 * * * *",
      "timezone": "UTC",
      "after": 1767225660000,
      "expected": { "kind": "next", "instant": 1767225960000 }
    },
    {
      "name": "list",
      "expression": "1,6,11 * * * *",
      "timezone": "UTC",
      "after": 1767225660000,
      "expected": { "kind": "next", "instant": 1767225960000 }
    },
    {
      "name": "named_month_and_weekday",
