{
  "name": "@silverhand/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "silverhand-server": "./src/main.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/server.js --external:better-sqlite3 --external:@node-rs/argon2 --minify=${SILVERHAND_MINIFY:-false} --banner:js='import{createRequire}from\"node:module\";const require=createRequire(import.meta.url);'",
    "start": "tsx src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@silverhand/backend": "workspace:*",
    "@silverhand/shared": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
