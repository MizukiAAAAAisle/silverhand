{
  "name": "@silverhand/host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./node-system-ca": "./src/node-system-ca.ts",
    "./daemon": "./src/daemon/index.ts",
    "./drivers": "./src/drivers/index.ts",
    "./outbound-protocol": "./src/outbound-protocol.ts",
    "./protocol": "./src/protocol.ts",
    "./runtimes": "./src/runtimes.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && esbuild src/daemon/entry.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/daemon.js --minify=${SILVERHAND_MINIFY:-false} --banner:js='import{createRequire}from\"node:module\";const require=createRequire(import.meta.url);'",
    "test": "vitest run",
    "test:dependency-guard": "vitest run tests/dependency-guard.test.ts",
    "test:publish-guards": "vitest run tests/dependency-guard.test.ts tests/silverhand-cli-launcher.test.ts tests/computer-profile.test.ts tests/connect-command.test.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@silverhand/shared": "workspace:*",
    "ws": "^8.20.0",
    "yaml": "^2.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
