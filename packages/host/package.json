{
  "name": "@silverhand/host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./daemon": "./src/daemon/index.ts",
    "./protocol": "./src/protocol.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && esbuild src/daemon/entry.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/daemon.js --banner:js='import{createRequire}from\"node:module\";const require=createRequire(import.meta.url);'",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@silverhand/shared": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
