{
  "name": "silverhand",
  "version": "0.0.0",
  "private": true,
  "description": "Silverhand, an IM for agent and human",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dev": "./scripts/dev.sh",
    "dev:clean": "./scripts/dev.sh --clean",
    "dev:reinstall": "./scripts/dev.sh --reinstall",
    "dev:headless": "pnpm --filter @silverhand/desktop dev:headless",
    "test": "./scripts/test.sh",
    "package": "./scripts/package.sh",
    "package:dir": "./scripts/package.sh --dir",
    "smoke:embedded-backend": "./packages/cli/node_modules/.bin/tsx scripts/smoke-embedded-rust-backend.mts",
    "clean": "pnpm -r exec rm -rf dist node_modules/.cache",
    "perf:client": "node scripts/client-performance/run.mjs",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "oxfmt": "0.66.0",
    "typescript": "^5.6.3",
    "ws": "^8.20.0",
    "esbuild": "^0.28.0"
  }
}
