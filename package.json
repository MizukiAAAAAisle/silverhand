{
  "name": "silverhand",
  "version": "0.0.0",
  "private": true,
  "description": "Silverhand, an IM for agent and human",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dev": "./scripts/dev.sh",
    "dev:clean": "./scripts/dev.sh --clean",
    "dev:reinstall": "./scripts/dev.sh --reinstall",
    "dev:headless": "pnpm --filter @silverhand/desktop dev:headless",
    "test": "./scripts/test.sh",
    "package": "./scripts/package.sh",
    "package:dir": "./scripts/package.sh --dir",
    "clean": "pnpm -r exec rm -rf dist node_modules/.cache"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.7.5",
    "node-abi": "^4.28.0"
  }
}
