{
  "annotations": { "list": [] },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP requests / second",
      "id": 1,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (route) (rate(silverhand_http_request_duration_seconds_count[5m]))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP latency p95 / p99",
      "id": 2,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(silverhand_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(silverhand_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP 5xx / second",
      "id": 3,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "sum by (route) (rate(silverhand_http_request_duration_seconds_count{status_class=\"5xx\"}[5m]))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Rust process memory",
      "id": 4,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        {
          "expr": "process_resident_memory_bytes{job=\"silverhand\"}",
          "legendFormat": "RSS",
          "refId": "A"
        },
        {
          "expr": "process_virtual_memory_bytes{job=\"silverhand\"}",
          "legendFormat": "virtual",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tokio scheduling delay",
      "id": 5,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "targets": [
        { "expr": "silverhand_tokio_scheduling_delay_seconds{job=\"silverhand\"}", "legendFormat": "timer delay", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Named SQLite latency p99",
      "id": 6,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, query_name) (rate(silverhand_db_statement_duration_seconds_bucket[5m])))",
          "legendFormat": "{{query_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Host WebSocket lifecycle",
      "id": 7,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(silverhand_host_ws_connections_total[5m]))",
          "legendFormat": "connect {{outcome}}",
          "refId": "A"
        },
        {
          "expr": "sum by (reason) (rate(silverhand_host_ws_closes_total[5m]))",
          "legendFormat": "close {{reason}}",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Daemon command latency p95",
      "id": 8,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, command) (rate(silverhand_daemon_command_duration_seconds_bucket[5m])))",
          "legendFormat": "{{command}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "ECS CPU utilization",
      "id": 9,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "targets": [
        {
          "expr": "1 - avg(rate(node_cpu_seconds_total{job=\"node\",mode=\"idle\"}[5m]))",
          "legendFormat": "CPU",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "ECS memory utilization",
      "id": 10,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "targets": [
        {
          "expr": "1 - (node_memory_MemAvailable_bytes{job=\"node\"} / node_memory_MemTotal_bytes{job=\"node\"})",
          "legendFormat": "memory",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "ECS root disk utilization",
      "id": 11,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "targets": [
        {
          "expr": "1 - (node_filesystem_avail_bytes{job=\"node\",mountpoint=\"/\"} / node_filesystem_size_bytes{job=\"node\",mountpoint=\"/\"})",
          "legendFormat": "root disk",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Ready daemon protocol distribution",
      "id": 12,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "targets": [
        {
          "expr": "sum by (protocol_version) (silverhand_host_ws_ready_connections_current)",
          "legendFormat": "protocol {{protocol_version}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Protocol mismatches",
      "id": 13,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "targets": [
        {
          "expr": "sum by (actual_version, supported_version) (increase(silverhand_host_ws_protocol_mismatch_total[5m]))",
          "legendFormat": "actual {{actual_version}} / supported {{supported_version}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["silverhand"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "Silverhand Server Overview",
  "uid": "silverhand-server-overview",
  "version": 1
}
