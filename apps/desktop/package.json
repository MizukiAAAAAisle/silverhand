{
  "name": "@silverhand/desktop",
  "productName": "Silverhand",
  "version": "0.3.0",
  "private": true,
  "description": "Silverhand — multi-agent coding hub (Electron desktop client)",
  "author": "shiki",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:headless": "SILVERHAND_HEADLESS=1 electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "start": "electron-vite preview",
    "start:headless": "electron-vite build && SILVERHAND_HEADLESS=1 electron ./out/main/index.js",
    "package": "../../scripts/package.sh",
    "package:dir": "../../scripts/package.sh --dir"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@silverhand/backend": "workspace:*",
    "@silverhand/host": "workspace:*",
    "@silverhand/shared": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^8.0.0",
    "@dnd-kit/sortable": "^9.0.0",
    "@types/node": "^22.19.17",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@fontsource/rajdhani": "^5.2.7",
    "@fontsource/space-grotesk": "^5.2.10",
    "@fontsource/space-mono": "^5.2.9",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-query": "^5.100.6",
    "@vitejs/plugin-react": "^6.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.20",
    "electron": "^42.6.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "6.0.0-beta.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.14.0",
    "mermaid": "^11.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.3",
    "react-virtuoso": "^4.18.7",
    "rehype-highlight": "^7.0.2",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.6.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
